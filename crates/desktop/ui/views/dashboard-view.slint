import {
    DashboardSectionRow, DashboardBoardSlotRow, DashboardQuotaRow, DashboardBenefitRow, DashboardTrendPoint,
    DashboardSessionRow, DashboardActivityRow, DashboardModelRow
} from "../models.slint";
import { UiTokens } from "../tokens.slint";
import { SectionState } from "../components/section-state.slint";
import { MetricValue } from "../components/metric-value.slint";
import { QuotaRowView } from "../components/quota-row.slint";
import { ScrollView } from "std-widgets.slint";

component CardHeader inherits Rectangle {
    in property <string> title;
    in property <string> state;
    in property <string> reasons;

    height: 28px;
    background: transparent;
    HorizontalLayout {
        spacing: UiTokens.space-sm;
        Text {
            text: root.title;
            color: UiTokens.text-primary;
            font-size: 15px;
            font-weight: 750;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        SectionState { state: root.state; reasons: root.reasons; }
    }
}

component DashboardHeaderCard inherits Rectangle {
    in property <string> tokens;
    in property <string> cost;
    in property <string> events;
    in property <string> evidence;

    min-height: 102px;
    background: UiTokens.surface;
    border-color: UiTokens.border;
    border-width: 1px;
    border-radius: UiTokens.radius-lg;
    accessible-role: region;
    accessible-label: @tr("Today's usage");

    VerticalLayout {
        padding: UiTokens.space;
        spacing: UiTokens.space-sm;
        HorizontalLayout {
            spacing: UiTokens.space;
            Text {
                text: @tr("Today");
                color: UiTokens.text-primary;
                font-size: 17px;
                font-weight: 800;
                horizontal-stretch: 1;
            }
            Text { text: root.evidence; color: UiTokens.text-secondary; font-size: 11px; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: UiTokens.space-lg;
            MetricValue { label: @tr("Tokens"); value: root.tokens; availability: root.tokens == "—" ? "unavailable" : "known"; horizontal-stretch: 1; }
            MetricValue { label: @tr("Cost"); value: root.cost; availability: root.cost == "—" ? "unavailable" : "known"; horizontal-stretch: 1; }
            MetricValue { label: @tr("Events"); value: root.events; availability: root.events == "—" ? "unavailable" : "known"; horizontal-stretch: 1; }
        }
    }
}

component ImportActivityDot inherits Rectangle {
    in property <bool> reduced-motion;
    in property <float> phase;

    width: 7px;
    height: 7px;
    background: UiTokens.accent;
    border-radius: 4px;
    opacity: root.reduced-motion ? 1.0 : 0.25 + 0.75 * abs(sin(360deg * (animation-tick() / 1.2s + root.phase)));
}

component InitialImportCard inherits Rectangle {
    in property <string> phase-label;
    in property <bool> reduced-motion;
    in property <bool> progress-known;
    in property <string> progress-label;
    in property <float> progress-ratio;

    min-height: 62px;
    background: UiTokens.surface-raised;
    border-color: UiTokens.accent;
    border-width: 1px;
    border-radius: UiTokens.radius-lg;
    accessible-role: groupbox;
    accessible-label: root.phase-label + " " + @tr("TokenMaster keeps available safe data visible while it imports the rest.");

    HorizontalLayout {
        padding: UiTokens.space;
        spacing: UiTokens.space-sm;
        VerticalLayout {
            spacing: 3px;
            ImportActivityDot { reduced-motion: root.reduced-motion; phase: 0.0; }
            ImportActivityDot { reduced-motion: root.reduced-motion; phase: 0.33; }
            ImportActivityDot { reduced-motion: root.reduced-motion; phase: 0.66; }
        }
        VerticalLayout {
            spacing: UiTokens.space-xs;
            Text { text: root.phase-label; color: UiTokens.text-primary; font-size: 13px; font-weight: 750; }
            if root.progress-known: HorizontalLayout {
                spacing: UiTokens.space-sm;
                Rectangle {
                    height: 5px;
                    horizontal-stretch: 1;
                    background: UiTokens.surface;
                    border-radius: 3px;
                    Rectangle {
                        width: max(2px, min(1.0, root.progress-ratio) * parent.width);
                        background: UiTokens.accent;
                        border-radius: 3px;
                    }
                }
                Text { text: root.progress-label; color: UiTokens.text-secondary; font-size: 11px; width: 92px; horizontal-alignment: right; }
            }
            if !root.progress-known: Text { text: @tr("TokenMaster keeps available safe data visible while it imports the rest."); color: UiTokens.text-secondary; font-size: 11px; wrap: word-wrap; }
        }
    }
}

component PlanUsageCard inherits Rectangle {
    in property <DashboardSectionRow> section;
    in property <[DashboardQuotaRow]> quotas;
    in property <[DashboardBenefitRow]> benefits;

    min-height: 190px;
    background: UiTokens.surface;
    border-color: UiTokens.border;
    border-width: 1px;
    border-radius: UiTokens.radius-lg;
    accessible-role: groupbox;
    accessible-label: @tr("Plan Usage");

    VerticalLayout {
        padding: UiTokens.space;
        spacing: UiTokens.space-sm;
        CardHeader { title: @tr("Plan Usage"); state: root.section.state; reasons: root.section.reasons; }
        if root.quotas.length == 0: Text {
            text: root.section.state == "waiting" ? @tr("Waiting for quota evidence") : @tr("Quota evidence unavailable");
            color: UiTokens.text-secondary;
            font-size: 12px;
        }
        for quota in root.quotas: QuotaRowView { quota-data: quota; }
        for benefit in root.benefits: Rectangle {
            min-height: 66px;
            background: UiTokens.surface-raised;
            border-radius: UiTokens.radius;
            accessible-role: groupbox;
            accessible-label: @tr("Banked resets {0}", benefit.reset-quantity-label);
            VerticalLayout {
                padding: UiTokens.space-sm;
                spacing: UiTokens.space-xs;
                HorizontalLayout {
                    Text { text: @tr("Banked resets"); color: UiTokens.text-primary; font-weight: 700; horizontal-stretch: 1; }
                    Text { text: benefit.reset-quantity-label; color: UiTokens.accent; font-size: 18px; font-weight: 800; }
                }
                Text {
                    text: benefit.expiry-label + " · " + benefit.reminder-label;
                    color: UiTokens.text-secondary;
                    font-size: 11px;
                    overflow: elide;
                }
                Text {
                    text: @tr("Credits {0} · Temporary {1} · Unavailable {2}", benefit.credit-quantity-label, benefit.temporary-quantity-label, benefit.unavailable-quantity-label);
                    color: UiTokens.text-secondary;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }
    }
}

component CodeOutputCard inherits Rectangle {
    in property <DashboardSectionRow> section;
    in property <string> commits;
    in property <string> added;
    in property <string> removed;
    in property <string> net;
    in property <string> efficiency;
    in property <string> evidence;

    min-height: 186px;
    background: UiTokens.surface;
    border-color: UiTokens.border;
    border-width: 1px;
    border-radius: UiTokens.radius-lg;
    accessible-role: groupbox;
    accessible-label: @tr("Code Output");

    VerticalLayout {
        padding: UiTokens.space;
        spacing: UiTokens.space-sm;
        CardHeader { title: @tr("Code Output"); state: root.section.state; reasons: root.section.reasons; }
        HorizontalLayout {
            spacing: UiTokens.space;
            MetricValue { label: @tr("Commits"); value: root.commits; availability: root.section.state; horizontal-stretch: 1; }
            MetricValue { label: @tr("+Added"); value: root.added; availability: root.section.state; horizontal-stretch: 1; }
            MetricValue { label: @tr("-Removed"); value: root.removed; availability: root.section.state; horizontal-stretch: 1; }
            MetricValue { label: @tr("Net"); value: root.net; availability: root.section.state; horizontal-stretch: 1; }
        }
        Text { text: root.efficiency; color: UiTokens.accent; font-size: 12px; }
        Text { text: root.evidence; color: UiTokens.text-secondary; font-size: 11px; overflow: elide; }
    }
}

component TrendCard inherits Rectangle {
    in property <DashboardSectionRow> section;
    in property <[DashboardTrendPoint]> points;
    in property <string> token-geometry;
    in property <string> cost-geometry;
    in property <string> token-axis;
    in property <string> cost-axis;

    min-height: 186px;
    background: UiTokens.surface;
    border-color: UiTokens.border;
    border-width: 1px;
    border-radius: UiTokens.radius-lg;
    accessible-role: groupbox;
    accessible-label: @tr("Usage and Cost Trend");

    VerticalLayout {
        padding: UiTokens.space;
        spacing: UiTokens.space-sm;
        CardHeader { title: @tr("Usage and Cost Trend"); state: root.section.state; reasons: root.section.reasons; }
        if root.points.length == 1: Rectangle {
            min-height: 112px;
            background: UiTokens.surface-subtle;
            border-radius: UiTokens.radius;
            accessible-role: image;
            accessible-label: root.points[0].date-label + " " + root.points[0].tokens-label + " " + root.points[0].cost-label;
            HorizontalLayout {
                padding: UiTokens.space;
                spacing: UiTokens.space-lg;
                VerticalLayout {
                    spacing: UiTokens.space-xs;
                    Text { text: @tr("Today"); color: UiTokens.text-secondary; font-size: 11px; }
                    Text { text: root.points[0].date-label; color: UiTokens.text-primary; font-size: 12px; overflow: elide; }
                }
                MetricValue {
                    label: @tr("Tokens");
                    value: root.points[0].tokens-label;
                    availability: root.points[0].tokens-availability;
                    horizontal-stretch: 1;
                }
                MetricValue {
                    label: @tr("Cost");
                    value: root.points[0].cost-label;
                    availability: root.points[0].cost-availability;
                    horizontal-stretch: 1;
                }
            }
        }
        if root.points.length > 1: Rectangle {
            min-height: 112px;
            background: UiTokens.surface-subtle;
            border-radius: UiTokens.radius;
            accessible-role: image;
            accessible-label: @tr("Daily token trend");
            Rectangle { x: UiTokens.space-sm; y: parent.height * 0.25; width: parent.width - 2 * UiTokens.space-sm; height: 1px; background: UiTokens.border; }
            Rectangle { x: UiTokens.space-sm; y: parent.height * 0.5; width: parent.width - 2 * UiTokens.space-sm; height: 1px; background: UiTokens.border; }
            Rectangle { x: UiTokens.space-sm; y: parent.height * 0.75; width: parent.width - 2 * UiTokens.space-sm; height: 1px; background: UiTokens.border; }
            Text { x: UiTokens.space-sm; y: 3px; text: root.token-axis; color: UiTokens.text-secondary; font-size: 9px; }
            Text { x: parent.width - self.width - UiTokens.space-sm; y: 3px; text: root.cost-axis; color: UiTokens.text-secondary; font-size: 9px; }
            Path {
                x: UiTokens.space-sm;
                y: 10px;
                width: parent.width - 2 * UiTokens.space-sm;
                height: parent.height - 22px;
                commands: root.token-geometry;
                viewbox-width: 1000;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                stroke: UiTokens.accent;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            Path {
                x: UiTokens.space-sm;
                y: 10px;
                width: parent.width - 2 * UiTokens.space-sm;
                height: parent.height - 22px;
                commands: root.cost-geometry;
                viewbox-width: 1000;
                viewbox-height: 100;
                fit: fill;
                clip: true;
                stroke: UiTokens.accent-secondary;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            HorizontalLayout {
                x: UiTokens.space-sm;
                y: 10px;
                width: parent.width - 2 * UiTokens.space-sm;
                height: parent.height - 10px;
                spacing: 0px;
                for point[i] in root.points: Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                    if mod(i, 3) == 0 || i == root.points.length - 1: Rectangle {
                        x: parent.width / 2 - 3px;
                        y: 0px + (1.0 - point.tokens-ratio) * (parent.height - 26px);
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: UiTokens.surface-subtle;
                        border-color: UiTokens.accent;
                        border-width: 2px;
                    }
                    if mod(i, 3) == 0 || i == root.points.length - 1: Rectangle {
                        x: parent.width / 2 - 2px;
                        y: 1px + (1.0 - point.cost-ratio) * (parent.height - 26px);
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: UiTokens.accent-secondary;
                    }
                    point-touch := TouchArea { }
                    if point-touch.has-hover: Rectangle {
                        z: 20;
                        x: i > root.points.length / 2 ? -154px : 8px;
                        y: 4px;
                        width: 154px;
                        height: 48px;
                        background: UiTokens.surface-raised;
                        border-color: UiTokens.border;
                        border-width: 1px;
                        border-radius: UiTokens.radius-sm;
                        VerticalLayout {
                            padding: UiTokens.space-xs;
                            spacing: 1px;
                            Text { text: point.date-label; color: UiTokens.text-primary; font-size: 10px; overflow: elide; }
                            Text { text: point.tokens-label + " · " + point.cost-label; color: UiTokens.text-secondary; font-size: 10px; overflow: elide; }
                        }
                    }
                    if i == 0 || i == root.points.length / 2 || i == root.points.length - 1: Text {
                        y: parent.height - 15px;
                        x: parent.width / 2 - self.width / 2;
                        text: point.axis-label;
                        color: UiTokens.text-secondary;
                        font-size: 8px;
                    }
                }
            }
        }
    }
}

component SessionsCard inherits Rectangle {
    in property <DashboardSectionRow> section;
    in property <[DashboardSessionRow]> rows;

    min-height: 210px;
    background: UiTokens.surface;
    border-color: UiTokens.border;
    border-width: 1px;
    border-radius: UiTokens.radius-lg;
    accessible-role: groupbox;
    accessible-label: @tr("Sessions");

    VerticalLayout {
        padding: UiTokens.space;
        spacing: UiTokens.space-sm;
        CardHeader { title: @tr("Sessions"); state: root.section.state; reasons: root.section.reasons; }
        for row[i] in root.rows: Rectangle {
            height: 34px;
            background: mod(i, 2) == 0 ? UiTokens.surface-subtle : transparent;
            border-radius: UiTokens.radius-sm;
            accessible-role: list-item;
            accessible-label: row.time-label + " " + row.tokens-label;
            HorizontalLayout {
                padding-left: UiTokens.space-sm;
                padding-right: UiTokens.space-sm;
                spacing: UiTokens.space-sm;
                Text { text: row.time-label; color: UiTokens.text-secondary; font-size: 11px; horizontal-stretch: 1; overflow: elide; }
                Text { width: 72px; text: row.tokens-label; color: UiTokens.text-primary; font-size: 11px; horizontal-alignment: right; overflow: elide; }
                Text { width: 82px; text: row.cost-label; color: UiTokens.text-secondary; font-size: 11px; horizontal-alignment: right; overflow: elide; }
            }
        }
    }
}

component ActivityCard inherits Rectangle {
    in property <DashboardSectionRow> section;
    in property <[DashboardActivityRow]> rows;

    min-height: 210px;
    background: UiTokens.surface;
    border-color: UiTokens.border;
    border-width: 1px;
    border-radius: UiTokens.radius-lg;
    accessible-role: groupbox;
    accessible-label: @tr("Activity");

    VerticalLayout {
        padding: UiTokens.space;
        spacing: 6px;
        CardHeader { title: @tr("Activity"); state: root.section.state; reasons: root.section.reasons; }
        for row in root.rows: HorizontalLayout {
            height: 20px;
            spacing: UiTokens.space-sm;
            Text { text: row.label; color: UiTokens.text-secondary; font-size: 11px; width: 74px; overflow: elide; }
            Rectangle {
                height: 6px;
                horizontal-stretch: 1;
                background: UiTokens.surface-raised;
                border-radius: 3px;
                Rectangle { width: row.ratio * parent.width; background: UiTokens.accent-secondary; border-radius: 3px; }
            }
            Text { text: row.count-label; color: UiTokens.text-primary; font-size: 11px; width: 36px; horizontal-alignment: right; }
        }
    }
}

component ModelsCard inherits Rectangle {
    in property <DashboardSectionRow> section;
    in property <[DashboardModelRow]> rows;

    min-height: 170px;
    background: UiTokens.surface;
    border-color: UiTokens.border;
    border-width: 1px;
    border-radius: UiTokens.radius-lg;
    accessible-role: groupbox;
    accessible-label: @tr("Model Usage");

    VerticalLayout {
        padding: UiTokens.space;
        spacing: 6px;
        CardHeader { title: @tr("Model Usage"); state: root.section.state; reasons: root.section.reasons; }
        for row in root.rows: HorizontalLayout {
            height: 28px;
            spacing: UiTokens.space-sm;
            Text { text: row.label; color: UiTokens.text-primary; font-size: 11px; width: 130px; overflow: elide; }
            Rectangle {
                height: 6px;
                horizontal-stretch: 1;
                background: UiTokens.surface-raised;
                border-radius: 3px;
                Rectangle { width: row.tokens-ratio * parent.width; background: UiTokens.accent-tertiary; border-radius: 3px; }
            }
            Text { text: row.tokens-label; color: UiTokens.text-primary; font-size: 11px; width: 60px; horizontal-alignment: right; }
            Text { text: row.cost-label; color: UiTokens.text-secondary; font-size: 11px; width: 76px; horizontal-alignment: right; }
        }
    }
}

component CollapsedSectionCard inherits Rectangle {
    in property <string> title;
    in property <string> state;
    in property <string> reasons;

    min-height: 74px;
    background: UiTokens.surface;
    border-color: UiTokens.border;
    border-width: 1px;
    border-radius: UiTokens.radius-lg;
    accessible-role: groupbox;
    accessible-label: @tr("{0} collapsed", root.title);
    VerticalLayout {
        padding: UiTokens.space;
        spacing: UiTokens.space-xs;
        CardHeader { title: @tr("{0} (collapsed)", root.title); state: root.state; reasons: root.reasons; }
        Text { text: @tr("Section collapsed; its data remains available."); color: UiTokens.text-secondary; font-size: 11px; }
    }
}

component DashboardBoardSlot inherits Rectangle {
    in property <DashboardBoardSlotRow> slot;
    in property <[DashboardSectionRow]> sections;
    in property <[DashboardQuotaRow]> quotas;
    in property <[DashboardBenefitRow]> benefits;
    in property <[DashboardTrendPoint]> trend;
    in property <string> trend-token-geometry;
    in property <string> trend-cost-geometry;
    in property <string> trend-token-axis;
    in property <string> trend-cost-axis;
    in property <[DashboardSessionRow]> sessions;
    in property <[DashboardActivityRow]> activity;
    in property <[DashboardModelRow]> models;
    in property <string> code-commits;
    in property <string> code-added;
    in property <string> code-removed;
    in property <string> code-net;
    in property <string> code-efficiency;
    in property <string> code-evidence;
    out property <DashboardSectionRow> active-section: slot.key == "plan_usage" ? root.sections[0] : (slot.key == "code_output" ? root.sections[1] : (slot.key == "trend" ? root.sections[2] : (slot.key == "sessions" ? root.sections[3] : (slot.key == "activity" ? root.sections[4] : root.sections[5]))));
    min-height: slot.collapsed ? 74px : (!root.active-section.has-data && (slot.key == "plan_usage" || slot.key == "code_output") ? 96px : (slot.key == "plan_usage" ? 190px : (slot.key == "code_output" || slot.key == "trend" ? 186px : (slot.key == "sessions" || slot.key == "activity" ? 210px : 170px))));

    if slot.collapsed: CollapsedSectionCard {
        width: parent.width;
        height: parent.height;
        title: slot.key == "plan_usage" ? @tr("Plan Usage") : (slot.key == "code_output" ? @tr("Code Output") : (slot.key == "trend" ? @tr("Usage and Cost Trend") : (slot.key == "sessions" ? @tr("Sessions") : (slot.key == "activity" ? @tr("Activity") : @tr("Model Usage")))));
        state: slot.key == "plan_usage" ? root.sections[0].state : (slot.key == "code_output" ? root.sections[1].state : (slot.key == "trend" ? root.sections[2].state : (slot.key == "sessions" ? root.sections[3].state : (slot.key == "activity" ? root.sections[4].state : root.sections[5].state))));
        reasons: slot.key == "plan_usage" ? root.sections[0].reasons : (slot.key == "code_output" ? root.sections[1].reasons : (slot.key == "trend" ? root.sections[2].reasons : (slot.key == "sessions" ? root.sections[3].reasons : (slot.key == "activity" ? root.sections[4].reasons : root.sections[5].reasons))));
    }
    if !slot.collapsed && slot.key == "plan_usage": PlanUsageCard { width: parent.width; height: parent.height; section: root.sections[0]; quotas: root.quotas; benefits: root.benefits; }
    if !slot.collapsed && slot.key == "code_output": CodeOutputCard { width: parent.width; height: parent.height; section: root.sections[1]; commits: root.code-commits; added: root.code-added; removed: root.code-removed; net: root.code-net; efficiency: root.code-efficiency; evidence: root.code-evidence; }
    if !slot.collapsed && slot.key == "trend": TrendCard {
        width: parent.width;
        height: parent.height;
        section: root.sections[2];
        points: root.trend;
        token-geometry: root.trend-token-geometry;
        cost-geometry: root.trend-cost-geometry;
        token-axis: root.trend-token-axis;
        cost-axis: root.trend-cost-axis;
    }
    if !slot.collapsed && slot.key == "sessions": SessionsCard { width: parent.width; height: parent.height; section: root.sections[3]; rows: root.sessions; }
    if !slot.collapsed && slot.key == "activity": ActivityCard { width: parent.width; height: parent.height; section: root.sections[4]; rows: root.activity; }
    if !slot.collapsed && slot.key == "models": ModelsCard { width: parent.width; height: parent.height; section: root.sections[5]; rows: root.models; }
}

export component DashboardView inherits Rectangle {
    in property <int> layout-id;
    in property <[DashboardSectionRow]> sections;
    in property <[DashboardBoardSlotRow]> slots;
    in property <[DashboardQuotaRow]> quotas;
    in property <[DashboardBenefitRow]> benefits;
    in property <[DashboardTrendPoint]> trend;
    in property <string> trend-token-geometry;
    in property <string> trend-cost-geometry;
    in property <string> trend-token-axis;
    in property <string> trend-cost-axis;
    in property <[DashboardSessionRow]> sessions;
    in property <[DashboardActivityRow]> activity;
    in property <[DashboardModelRow]> models;
    in property <string> header-tokens;
    in property <string> header-cost;
    in property <string> header-events;
    in property <string> header-evidence;
    in property <bool> initial-import-in-progress;
    in property <bool> import-progress-known;
    in property <string> import-progress-label;
    in property <float> import-progress-ratio;
    in property <bool> startup-import-in-progress;
    in property <int> initial-import-stage;
    in property <bool> reduced-motion;
    in property <string> code-commits;
    in property <string> code-added;
    in property <string> code-removed;
    in property <string> code-net;
    in property <string> code-efficiency;
    in property <string> code-evidence;
    out property <bool> narrow: root.width < 760px;
    out property <bool> initial-import-visible: root.initial-import-in-progress || root.startup-import-in-progress;
    out property <string> initial-import-phase-label: root.initial-import-stage >= 2 ? @tr("Importing local usage history…") : (root.initial-import-stage == 1 ? @tr("Starting safe import…") : @tr("Checking local usage history…"));
    out property <string> layout-mode: root.narrow ? "narrow" : "wide";
    out property <string> layout-preset: root.layout-id == 2 ? "workbench" : (root.layout-id == 1 ? "control_center" : "refined");

    background: UiTokens.background;

    ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.width;
